# SonarQube Project Configuration
sonar.projectKey={{PROJECT_KEY}}
sonar.projectName={{PROJECT_NAME}}
sonar.projectVersion=1.0.0

# Source & Test paths
sonar.sources=src
# sonar.tests=test

# Exclusions
sonar.exclusions=\
  **/node_modules/**,\
  **/dist/**,\
  **/build/**,\
  **/coverage/**,\
  **/*.d.ts,\
  sonar-project.properties

# Encoding & SCM
sonar.sourceEncoding=UTF-8
sonar.scm.disabled=true
