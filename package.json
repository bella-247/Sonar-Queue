{
  "name": "sonar-queue",
  "version": "1.0.0",
  "description": "Token-optimized SonarQube queue manager and issue resolution engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sonar-queue": "bin/sonar-queue.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bella-247/Sonar-Queue.git"
  },
  "homepage": "https://github.com/bella-247/Sonar-Queue#readme",
  "bugs": {
    "url": "https://github.com/bella-247/Sonar-Queue/issues"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist', { recursive: true, force: true });\" && tsc && cp -r templates dist/ 2>/dev/null || true",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "tsx index.ts",
    "pack": "npm run build && npm pack"
  },
  "keywords": [
    "sonarqube",
    "code-quality",
    "ai-agent",
    "resolution-queue",
    "token-optimization"
  ],
  "author": "Abel Mekonen <abelmekonen247@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
